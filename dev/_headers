/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self'; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
/privacy-policy.html
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://privacyportalde-cdn.onetrust.com; font-src 'self' data:; style-src 'self' 'unsafe-inline' https://privacyportalde-cdn.onetrust.com; script-src 'self' https://privacyportalde-cdn.onetrust.com; connect-src 'self' https://privacyportalde-cdn.onetrust.com https://privacyportal-de.onetrust.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
/images/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
